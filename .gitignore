__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

.venv/
venv/
.env
.envrc

.ipynb_checkpoints/
.jupyter/

# Heavy artefacts — never commit
data/raw/
data/processed/
artifacts/
*.pt
*.npy
*.npz
*.parquet

.DS_Store
.idea/
.vscode/
*.swp

# HF + Torch caches
.cache/
huggingface/

.coverage
htmlcov/
.pytest_cache/
.ruff_cache/
.kaggle_kernel_id
kaggle/kernel.ipynb

# Editing-run staging zips (extract into results/editing*/<model>/ instead of committing the zip)
results/**/*.zip

# Bender HPC: local reference docs (PDFs) and cluster run outputs
bender_documentation/
sc-out/

# F2 harmful-transfer: only the *_agg.csv (aggregate rates/ASR) is committed. Never commit any
# raw harmful continuations — block any non-aggregate harmful-transfer artifact defensively.
results/**/*_harmful_transfer_raw.*
results/**/*_harmful_transfer.jsonl
results/**/*_harmful_transfer.csv

# LaTeX build artifacts (commit the .tex and the built .pdf, never the intermediates).
# Scoped to slides/ so run logs elsewhere in the repo stay committable.
slides/*.aux
slides/*.fdb_latexmk
slides/*.fls
slides/*.log
slides/*.nav
slides/*.out
slides/*.snm
slides/*.toc
slides/*.xdv
slides/*.synctex.gz
